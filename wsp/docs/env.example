# Variaveis necessarias para o WhatsApp conectado

# URL base da Evolution API. Exemplo:
# EVOLUTION_BASE_URL=https://evolution.seudominio.com
EVOLUTION_BASE_URL=

# Chave global da Evolution. Nunca commitar valor real.
EVOLUTION_GLOBAL_API_KEY=

# Opcional: URL visual do manager/admin da Evolution.
EVOLUTION_MANAGER_URL=

# URL publica do Gabinete360 usada para configurar webhook.
# Precisa ser HTTPS publico; localhost/127.0.0.1 nao configura webhook.
# Exemplo: https://gabinete.guiapj.com.br
GABINETE360_PUBLIC_URL=

# Recomendado para datas e historico.
TZ=America/Sao_Paulo

# Observacao:
# Se EVOLUTION_BASE_URL ou EVOLUTION_GLOBAL_API_KEY estiver vazio, o sistema cai para modo wa.me.
# Nesse modo texto abre WhatsApp Web e anexo fica bloqueado.
